{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "云笈",
  "version": "0.6.0",
  "identifier": "com.cloudsatchel.app",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "云笈",
        "width": 760,
        "height": 560,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "installMode": "both"
      }
    }
  }
}
